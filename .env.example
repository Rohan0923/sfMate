# Copy to .env for running sfMate on your Mac. Never commit .env (it's in .gitignore).
APP_ENV=development
# DATABASE_URL=            # blank = a local SQLite file (sfmate-dev.db)

# RunPod Serverless endpoint running vLLM
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# sfMate Gmail: reads Daily Announcements and sends sign-up codes.
# Blank in development = codes are printed in the server log instead of emailed.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

ALLOWED_EMAIL_DOMAIN=sfhs.com
DAILY_MESSAGE_LIMIT=40
GOOGLE_CLIENT_ID=
